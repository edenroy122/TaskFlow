# Server Port (Render automatically sets PORT in production)
PORT=3000

# MongoDB Connection String (Atlas URI)
# Supports either MONGOOSE or MONGODB_URI
MONGOOSE=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow

# JWT Authentication Secret (Use a strong random string)
JWT_SECRET=your_jwt_secret_token

# Allowed Frontend URL(s) for CORS & Socket.IO (comma-separated if multiple, e.g. production and preview)
CLIENT_URL=https://your-frontend.vercel.app

# Passkey required for creating/joining spaces
SPACE_PASSKEY=#Mistral_Solution_Create@2026

# Supabase Cloud Storage for Attachments
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_BUCKET=TaskFlow
